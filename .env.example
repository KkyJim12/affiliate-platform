# Required for production wallet login: exact canonical origin, also used for referral links.
NUXT_PUBLIC_APP_URL=http://localhost:3000
# Default: external wallets sign in and approve every on-chain write.
# Set embedded only to intentionally restore the retained in-app wallet feature.
NUXT_PUBLIC_WALLET_MODE=external
# Amoy application default. For mainnet use .env.mainnet.example and mainnet commands.
NUXT_PUBLIC_CHAIN_ID=80002
# Member ID/password login stays hidden and blocked by default.
# Set true and restart to temporarily enable existing-account linking or legacy login.
# Administrators always sign in with member ID/password at /admin/login.
NUXT_PUBLIC_PASSWORD_LOGIN_ENABLED=false
# Required: PostgreSQL. Local development credentials match compose.yaml.
# The database must exist; the server applies migrations at startup.
# For hosted PostgreSQL, use the provider's URL and SSL options (e.g. sslmode=verify-full).
DATABASE_URL=postgresql://unxo:unxo_local_dev@127.0.0.1:5432/unxo
# Optional: separate disposable PostgreSQL database for browser tests.
# TEST_DATABASE_URL=postgresql://unxo:unxo_local_dev@127.0.0.1:5432/unxo_test
# Optional for non-interactive `npm run admin:create`; normally use its prompts.
# LOOP_ADMIN_PASSWORD=
# Server-only EVM configuration for reads and Amoy referral purchases.
# Wallet balances default to the public Amoy RPC and native POL.
# Override RPC_URL and optionally TOKEN_ADDRESS for an Amoy ERC-20 balance.
# If CHAIN_ID is set for wallet balances, it must be 80002.
# Transfer-evidence helpers require all five settings together.
# Supported chain IDs: Ethereum 1, BNB Chain 56, Polygon 137, Amoy 80002, Sepolia 11155111.
# Choose the token contract, treasury and confirmation policy for the SAME chain.
# Token precision is read from decimals(); the ledger always uses six decimals.
# Reads need no key. Connected wallets sign purchases and transfers;
# the separate quote authority below only attests purchase eligibility.
NUXT_EVM_RPC_URL=
NUXT_EVM_CHAIN_ID=
NUXT_EVM_TOKEN_ADDRESS=
NUXT_EVM_TREASURY_ADDRESS=
NUXT_EVM_MIN_CONFIRMATIONS=
# Optional: Etherscan V2 API key with Polygon Amoy access for wallet history.
# Keep server-side. History shows an unavailable state until this is configured.
NUXT_EVM_EXPLORER_API_KEY=
# In embedded mode only: account wallets use Polygon Amoy (80002), created offline.
# Their private keys use password-encrypted Ethers keystores in PostgreSQL.
# No .env encryption key or RPC connection is required to create/reveal a wallet.

# Referral purchases default to SMART-CONTRACT payments on Polygon Amoy.
# Run `npm run contracts:prepare` to compile both contracts, create a server-only
# quote authority key if missing, and write a public deployment plan.
# Set these two PUBLIC addresses before deploying:
# Use the account's EVM address from your admin wallet to manage fees in the app.
REFERRAL_OWNER_ADDRESS=
REFERRAL_FEE_RECIPIENT_ADDRESS=
# Source verification: Etherscan V2 API key. Existing NUXT_EVM_EXPLORER_API_KEY
# is also accepted when this is blank. Run `npm run contracts:verify`.
ETHERSCAN_API_KEY=
# Optional verification fallback when the saved deployment record is unavailable.
# This is the ORIGINAL quote signer PUBLIC address, not a private key.
# REFERRAL_QUOTE_SIGNER_ADDRESS=
# Deployment only: a separate wallet funded with test POL. Never expose this key.
REFERRAL_DEPLOYER_PRIVATE_KEY=
# Server only: signs purchase eligibility/genealogy authorizations, not transfers.
# `contracts:prepare` generates this once without printing the key.
NUXT_REFERRAL_AUTHORITY_PRIVATE_KEY=
# Both token and referral contract addresses are saved here after deployment.
# Paid rebirths require a distributor exposing rebirthVersion() = 1.
# Existing distributors need replacement; see docs/matrix-payments.md.
# Set the existing NUXT_EVM_CHAIN_ID above to 80002 and use an Amoy RPC.
NUXT_REFERRAL_CONTRACT_ADDRESS=
NUXT_REFERRAL_PAYMENT_MODE=contract
NUXT_REFERRAL_MIN_CONFIRMATIONS=2
# Minimum displayed gas budget for administrative contract updates.
# Purchases do not require a gas quote or check the native POL balance.
NUXT_REFERRAL_MIN_GAS_BALANCE=0.003
# NUXT_EVM_TOKEN_ADDRESS above is the deployed AmoyTestUSDT (tUSDT), NOT real USDT.
# Explicit legacy compatibility: paymentMode=ledger enables the previous internal
# credit flow. Contract mode never falls back to internal debits or credits.
