# Optional: canonical origin used when generating referral links.
NUXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: SQLite path. Use persistent local storage for production.
# The server applies versioned migrations at startup; inspect with npm run db:status.
LOOP_DATABASE_PATH=.data/loop.sqlite
# Optional for non-interactive `npm run admin:create`; normally use its prompts.
# LOOP_ADMIN_USERNAME=
# LOOP_ADMIN_PASSWORD=
