# Optional: canonical origin used when generating referral links.
NUXT_PUBLIC_APP_URL=http://localhost:3000
# Required: PostgreSQL. Local development credentials match compose.yaml.
# The database must exist; the server applies migrations at startup.
# For hosted PostgreSQL, use the provider's URL and SSL options (e.g. sslmode=verify-full).
DATABASE_URL=postgresql://unxo:unxo_local_dev@127.0.0.1:5432/unxo
# Optional: separate disposable PostgreSQL database for browser tests.
# TEST_DATABASE_URL=postgresql://unxo:unxo_local_dev@127.0.0.1:5432/unxo_test
# Optional for non-interactive `npm run admin:create`; normally use its prompts.
# LOOP_ADMIN_USERNAME=
# LOOP_ADMIN_PASSWORD=
# Optional: server-only, read-only EVM configuration.
# Wallet balances default to the public Amoy RPC and native POL.
# Override RPC_URL and optionally TOKEN_ADDRESS for an Amoy ERC-20 balance.
# If CHAIN_ID is set for wallet balances, it must be 80002.
# Transfer-evidence helpers require all five settings together.
# Supported chain IDs: Ethereum 1, BNB Chain 56, Polygon 137, Amoy 80002, Sepolia 11155111.
# Choose the token contract, treasury and confirmation policy for the SAME chain.
# Token precision is read from decimals(); the ledger always uses six decimals.
# No private key is needed. This does not enable automatic funding or withdrawals.
NUXT_EVM_RPC_URL=
NUXT_EVM_CHAIN_ID=
NUXT_EVM_TOKEN_ADDRESS=
NUXT_EVM_TREASURY_ADDRESS=
NUXT_EVM_MIN_CONFIRMATIONS=
# Optional: Etherscan V2 API key with Polygon Amoy access for wallet history.
# Keep server-side. History shows an unavailable state until this is configured.
NUXT_EVM_EXPLORER_API_KEY=
# Account wallets are always Polygon Amoy (80002) and are created offline.
# Their private keys use password-encrypted Ethers keystores in PostgreSQL.
# No .env encryption key or RPC connection is required to create/reveal a wallet.
