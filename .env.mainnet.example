# Polygon mainnet deployment and application. Copy to .env.mainnet.
# These commands do not load .env or reuse its Amoy deployment records.
NUXT_PUBLIC_APP_URL=https://your-domain.example
NUXT_PUBLIC_WALLET_MODE=external
NUXT_PUBLIC_PASSWORD_LOGIN_ENABLED=false
NUXT_PUBLIC_CHAIN_ID=137
NUXT_EVM_CHAIN_ID=137
NUXT_EVM_RPC_URL=https://polygon.drpc.org
# Existing Polygon USDT (now USDT0), six decimals. Never deploy a mock on mainnet.
NUXT_EVM_TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
NUXT_EVM_MIN_CONFIRMATIONS=3
NUXT_EVM_EXPLORER_API_KEY=
NUXT_REFERRAL_PAYMENT_MODE=contract
NUXT_REFERRAL_CONTRACT_ADDRESS=
NUXT_REFERRAL_MIN_CONFIRMATIONS=3
NUXT_REFERRAL_MIN_GAS_BALANCE=0.003
# Use a dedicated mainnet database. Amoy paid history cannot be imported as paid levels.
DATABASE_URL=postgresql://unxo:unxo_local_dev@127.0.0.1:5432/unxo_mainnet
# Public owner and platform recipient. Owner may be a multisig.
REFERRAL_OWNER_ADDRESS=
REFERRAL_FEE_RECIPIENT_ADDRESS=
# Server-only keys. The deployer pays real mainnet POL gas.
REFERRAL_DEPLOYER_PRIVATE_KEY=
NUXT_REFERRAL_AUTHORITY_PRIVATE_KEY=
# Optional public quote signer for a separate signing service / keyless preparation.
REFERRAL_QUOTE_SIGNER_ADDRESS=
# Hard ceiling on the deployment transaction's maximum gas cost, in POL.
MAINNET_MAX_DEPLOYMENT_COST_POL=1
ETHERSCAN_API_KEY=
