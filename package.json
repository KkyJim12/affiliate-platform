{
  "name": "affiliate-platform",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:summary:pdf": "node scripts/generate-doc-summary.mjs",
    "docs:deploy:pdf": "node scripts/generate-deploy-docs.mjs",
    "typecheck": "nuxt typecheck",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "admin:list": "node --env-file-if-exists=.env scripts/create-admin.mjs --list",
    "test:ui": "node scripts/test-postgres.mjs ui",
    "test:i18n": "node --test tests/locales.test.mjs",
    "test:contracts": "node --test tests/evm.test.mjs tests/evm-wallet.test.mjs tests/evm-balance.test.mjs tests/evm-transactions.test.mjs",
    "test:compensation": "node --test tests/compensation.test.mjs",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:prepare": "node --env-file-if-exists=.env scripts/prepare-referral.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env scripts/deploy-referral.mjs",
    "contracts:verify": "node --env-file-if-exists=.env scripts/verify-referral.mjs",
    "contracts:mainnet:prepare": "node --env-file-if-exists=.env.mainnet scripts/prepare-mainnet.mjs",
    "contracts:mainnet:deploy": "node --env-file-if-exists=.env.mainnet scripts/deploy-mainnet.mjs",
    "contracts:mainnet:verify": "node --env-file-if-exists=.env.mainnet scripts/verify-mainnet.mjs",
    "dev:mainnet": "node --env-file=.env.mainnet node_modules/nuxt/bin/nuxt.mjs dev --dotenv .env.mainnet",
    "build:mainnet": "node --env-file=.env.mainnet node_modules/nuxt/bin/nuxt.mjs build --dotenv .env.mainnet",
    "start:mainnet": "node --env-file=.env.mainnet .output/server/index.mjs",
    "db:mainnet:migrate": "node --env-file=.env.mainnet scripts/database.mjs migrate",
    "admin:mainnet:create": "node --env-file=.env.mainnet scripts/create-admin.mjs",
    "test:mainnet": "node --test tests/mainnet.test.mjs tests/mainnet-deployment.test.mjs",
    "test:mainnet:app": "node scripts/test-onchain.mjs --mainnet",
    "test:verification": "node --test tests/referral-verification.test.mjs",
    "test:distributor": "node --test tests/referral-contract.test.mjs tests/referral-chain.test.mjs tests/referral-deployment.test.mjs",
    "test:onchain": "node scripts/test-onchain.mjs",
    "test:connected": "node scripts/test-onchain.mjs --external",
    "test:wallet-auth": "node --test tests/wallet-challenge.test.mjs",
    "test:admin-wallet": "node scripts/test-onchain.mjs --external admin-wallet-binding.spec.ts --grep \"admin Settings permanently|administrator IDs other than 1|wallet-only members\"",
    "test:sends": "node --test tests/evm-send.test.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:start": "node --env-file-if-exists=.env scripts/local-postgres.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-database.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/database.mjs status",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-database.mjs",
    "db:mainnet:backup": "node --env-file=.env.mainnet scripts/backup-database.mjs",
    "db:backup:decrypt": "node --env-file-if-exists=.env scripts/decrypt-database-backup.mjs",
    "db:mainnet:backup:decrypt": "node --env-file=.env.mainnet scripts/decrypt-database-backup.mjs",
    "test:backup": "node --test tests/database-backup.test.mjs",
    "test:db": "node scripts/test-postgres.mjs db",
    "db:import:sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@lucide/vue": "^1.58.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "ethers": "^6.17.0",
    "izitoast": "^1.4.0",
    "nodemailer": "^10.3.1",
    "nuxt": "^4.6.1",
    "nuxt-toast": "^1.4.0",
    "pg": "^8.23.1",
    "viem": "^2.57.7",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "hardhat": "3.20.0",
    "solc": "0.8.37",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24"
  }
}
